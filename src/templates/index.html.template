<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{title}}</title>
<meta name="description" content="{{meta_description}}">
<meta property="og:title" content="{{og_title}}">
<meta property="og:description" content="{{og_description}}">
<meta property="og:type" content="website">
<link rel="canonical" href="{{canonical}}">
<link rel="icon" type="image/jpeg" href="assets/images/logo.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="assets/css/style.css">
<script src="assets/js/main.js" defer></script>
{{hreflang_block}}
{{schema_block}}
</head>
<body>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="index"><img src="assets/images/logo.jpg" alt="YUKFO logo"><span>YUKFO</span></a>
    <nav class="nav" aria-label="Main navigation">
      <a href="index" class="active">Home</a>
      <a href="services">Services</a>
      <a href="work">Work</a>
      <a href="contact">Contact</a>
    </nav>
    <button class="menu-toggle" onclick="toggleMenu()" aria-label="Menu">☰</button>
  </div>
</header>

<main>
  <section class="hero-split">
    <div class="container">
      <div class="hero-text">
        <h1>{{hero_h1}} <span style="color:var(--gold-deep)">{{hero_h1_accent}}</span></h1>
        <p class="sub">{{hero_sub}}</p>
        <a class="btn" href="contact">{{cta_primary}}</a>
        <a class="btn btn-ghost" href="contact" style="margin-left:10px">{{cta_secondary}}</a>
        <p style="margin-top:16px;color:var(--gray);font-size:.82rem">Reply within 24 hours on working days.</p>
        <!-- BR No. 待核验证书后加回（候选 80477500）：缺信息比假信息安全 -->
        <p style="margin-top:6px;color:var(--gray);font-size:.82rem">Yukfo Limited · Hong Kong</p>
      </div>
      <div class="hero-img"><img src="assets/images/work/work-plastic-parts.jpg" alt="Colored plastic parts from a delivered project"></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>How It Works</h2>
      <p class="lead">Tell me what you need. From there, one person coordinates the whole process.</p>
      <div class="flow">
        <div class="step"><div class="n">01</div><div class="t">Send your product idea or specifications</div><div class="d">A drawing, a spec, or a rough idea is all it takes.</div></div>
        <div class="step"><div class="n">02</div><div class="t">I find suitable suppliers and coordinate the process</div><div class="d">Quotes compared, samples verified, production followed up.</div></div>
        <div class="step"><div class="n">03</div><div class="t">Samples, quality checks and delivery are managed through one contact</div><div class="d">One person answers for the whole process.</div></div>
      </div>
      <p style="margin-top:26px"><a class="btn" href="contact">Start a Project</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Recent Work</h2>
      <div class="case-grid">
        <div class="case-card"><img src="assets/images/work/work-mold-and-bottle.jpg" alt="Injection mold and molded bottle"><div class="c-body"><span class="c-tag">INJECTION MOLDING</span><h3>Mold &amp; Bottle</h3></div></div>
        <div class="case-card"><img src="assets/images/work/work-plastic-parts.jpg" alt="Colored plastic parts"><div class="c-body"><span class="c-tag">CUSTOM PLASTIC</span><h3>Plastic Parts</h3></div></div>
        <div class="case-card"><img src="assets/images/work/work-precision-metal.jpg" alt="Precision metal parts"><div class="c-body"><span class="c-tag">METAL FABRICATION</span><h3>Precision Metal</h3></div></div>
      </div>
      <p style="margin-top:26px"><a class="btn btn-ghost" href="work">See All Work</a></p>
    </div>
  </section>
</main>

<footer class="site-footer footer-line">
  <div class="container">
    <span>© 2026 YUKFO · Yukfo Limited, Hong Kong</span>
  </div>
</footer>
</body>
</html>
