<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{title}}</title>
<meta name="description" content="{{meta_description}}">
<meta property="og:title" content="{{og_title}}">
<meta property="og:description" content="{{og_description}}">
<meta property="og:type" content="website">
<link rel="canonical" href="{{canonical}}">
<link rel="icon" type="image/jpeg" href="assets/images/logo.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="assets/css/style.css">
<script src="assets/js/main.js" defer></script>
{{hreflang_block}}
{{schema_block}}
</head>
<body>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="index"><img src="assets/images/logo.jpg" alt="YUKFO logo"><span>YUKFO</span></a>
    <nav class="nav" aria-label="Main navigation">
      <a href="index">Home</a>
      <a href="services">Services</a>
      <a href="work" class="active">Work</a>
      <a href="contact">Contact</a>
    </nav>
    <button class="menu-toggle" onclick="toggleMenu()" aria-label="Menu">☰</button>
  </div>
</header>

<main>
  <section class="section" style="border-top:0">
    <div class="container">
      <h2>Work</h2>
      <p class="lead">Photos of real parts, tooling and projects I have coordinated. Client names stay confidential, but references are available on request.</p>
      <div class="case-grid">
        <div class="case-card" data-img="assets/images/work/work-mold-and-bottle.jpg"><img src="assets/images/work/work-mold-and-bottle.jpg" alt="Blow molded bottle with its mold"><div class="c-body"><span class="c-tag">BLOW MOLDING</span><h3>Custom Bottle with Tooling</h3><div class="case-meta"><span class="m">Mold development, supplier coordination, sample review</span></div></div></div>
        <div class="case-card" data-img="assets/images/work/work-electrical-panel.jpg"><img src="assets/images/work/work-electrical-panel.jpg" alt="Injection mold"><div class="c-body"><span class="c-tag">INJECTION MOLDING</span><h3>Custom Injection Mold</h3><div class="case-meta"><span class="m">Tooling coordination, material selection, sample review</span></div></div></div>
        <div class="case-card" data-img="assets/images/work/work-aluminum-extrusion.jpg"><img src="assets/images/work/work-aluminum-extrusion.jpg" alt="Aluminum extrusion profile"><div class="c-body"><span class="c-tag">ALUMINUM EXTRUSION</span><h3>Window &amp; Door Profiles</h3><div class="case-meta"><span class="m">Die development, surface finishing, supplier coordination</span></div></div></div>
        <div class="case-card" data-img="assets/images/work/work-pvc-extrusion.jpg"><img src="assets/images/work/work-pvc-extrusion.jpg" alt="PVC extrusion profiles"><div class="c-body"><span class="c-tag">PVC EXTRUSION</span><h3>Structural Profiles</h3><div class="case-meta"><span class="m">Profile requirement review, custom lengths, supplier coordination</span></div></div></div>
        <div class="case-card" data-img="assets/images/work/work-die-casting.jpg"><img src="assets/images/work/work-die-casting.jpg" alt="Die cast zinc parts"><div class="c-body"><span class="c-tag">DIE CASTING</span><h3>Zinc Alloy Parts</h3><div class="case-meta"><span class="m">Tooling coordination, material verification, sample review</span></div></div></div>
        <div class="case-card" data-img="assets/images/work/work-rotomold-aluminum.jpg"><img src="assets/images/work/work-rotomold-aluminum.jpg" alt="Aluminum rotomolding mold"><div class="c-body"><span class="c-tag">ROTOMOLDING</span><h3>Aluminum Rotomolding Mold</h3><div class="case-meta"><span class="m">Mold fabrication coordination, supplier communication</span></div></div></div>
        <div class="case-card" data-img="assets/images/work/work-factory-line.jpg"><img src="assets/images/work/work-factory-line.jpg" alt="Steel rotomolding mold"><div class="c-body"><span class="c-tag">ROTOMOLDING</span><h3>Steel Rotomolding Mold</h3><div class="case-meta"><span class="m">Steel mold fabrication coordination</span></div></div></div>
        <div class="case-card" data-img="assets/images/work/work-metal-assembly.jpg"><img src="assets/images/work/work-metal-assembly.jpg" alt="Hardware components"><div class="c-body"><span class="c-tag">HARDWARE PARTS</span><h3>Hardware Components</h3><div class="case-meta"><span class="m">Sourcing and supplier coordination for hardware components</span></div></div></div>
        <div class="case-card" data-img="assets/images/work/work-finished-product.jpg"><img src="assets/images/work/work-finished-product.jpg" alt="Industrial fan sourced as an alternative product"><div class="c-body"><span class="c-tag">PRODUCT SOURCING</span><h3>Alternative Product Solution</h3><div class="case-meta"><span class="m">Finding suitable alternatives when an exact product is not available</span></div></div></div>
      </div>
      <div class="case-meta" style="margin-top:30px"><span class="m"><b>Programs:</b> 26-SKU blind system · rotomolded kayaks (LLDPE) · window &amp; door profiles (aluminum 6063, PVC) · water tanks · planters · EVA/IXPE foam panels</span></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Start a New Project</h2>
      <p class="lead">Every project above started with a drawing and a question. Send yours.</p>
      <a class="btn" href="contact">Start Your Project</a>
    </div>
  </section>
</main>

<footer class="site-footer footer-line">
  <div class="container">
    <span>© 2026 YUKFO · Yukfo Limited, Hong Kong</span>
  </div>
</footer>
</body>
</html>
